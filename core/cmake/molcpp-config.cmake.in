@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/molcpp-targets.cmake")
check_required_components("@PROJECT_NAME@")

get_target_property(IMPORTED_CONFIGURATIONS molcpp IMPORTED_CONFIGURATIONS)

get_target_property(IMPORTED_SONAME molcpp "IMPORTED_SONAME_${IMPORTED_CONFIGURATIONS}")
if (IMPORTED_SONAME)
    set_target_properties(molcpp PROPERTIES IMPORTED_SONAME "${IMPORTED_SONAME}")
endif()